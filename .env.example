# ==============================================
# LMS - Konfigurasi Deployment (root)
# Copy file ini jadi .env lalu sesuaikan:
#   cp .env.example .env
# ==============================================

# ---------- Aplikasi ----------
APP_NAME=LMS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3006

# Wajib diisi! Generate dengan:
#   docker compose exec backend php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

BCRYPT_ROUNDS=12

# ---------- Port (host) ----------
# Frontend (SPA) : range 3000-3099
FRONTEND_PORT=3006
# Backend  (API) : range 4000-4099
BACKEND_PORT=4001

# ---------- Database (PostgreSQL homelab) ----------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=admin
DB_PASSWORD=changeme

# ---------- Session / Cache / Queue ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Redis (opsional, belum dipakai) ----------
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
